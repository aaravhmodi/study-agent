    {
      "id": "f78dc9b7-f3aa-53f4-9d86-6b41380ccf2d",
      "name": "Deadlines",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        660,
        540
      ],
      "parameters": {
        "toolDescription": "Every assignment, quiz, test, lab, project and exam in his courses, with when it is due in Toronto time and whether it is done. Use for anything about what is due, overdue or coming up.",
        "method": "GET",
        "url": "={{ $env.STUDY_AGENT_URL }}/assessments",
        "options": {
          "timeout": 60000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.STUDY_AGENT_TOKEN }}"
            }
          ]
        },
        "optimizeResponse": true,
        "responseType": "json",
        "dataField": "",
        "fieldsToInclude": "selected",
        "fields": "course,title,type,due_local,status"
      }
    },
