OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_CHAT_MODEL=gpt-6-luna
# Course text sent with each question (tokens), and whether answers may add web context.
RAG_CONTEXT_TOKENS=3000
RAG_WEB_SEARCH=true
BROWSER_MODE=local
DATABASE_URL=sqlite:///./data/study_agent.db
LEARN_URL=https://learn.uwaterloo.ca
BROWSER_USE_API_KEY=
BROWSER_USE_EXECUTABLE=browser-use
TIMEZONE=America/Toronto
# Home server (optional): where scripts/server-sync.sh sends the data, and the address
# compose.yaml publishes the dashboard on. See "Run it on a home server" in the README.
STUDY_SERVER=
TAILSCALE_IP=
# On the server: the password the dashboard asks for (12 characters or more). It is
# required to serve the dashboard beyond the computer it runs on.
DASHBOARD_PASSWORD=
# The server's public https address, which scripts/deploy-frontend.sh points Vercel at.
STUDY_API_URL=
# On the server: where you sign in to LEARN in its browser. compose.yaml sets it.
LEARN_SIGNIN_URL=
